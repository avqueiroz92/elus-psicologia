---
import BaseLayout from "./BaseLayout.astro";
import { site } from "../config/site";

type Props = {
  title: string;
  description: string;
  category: string;
  readTime: string;
  serviceHref: string;
  serviceLabel: string;
};

const { title, description, category, readTime, serviceHref, serviceLabel } = Astro.props;
---

<BaseLayout title={`${title} | ELUS Psicologia`} description={description}>
  <main class="pt-16 sm:pt-20">
    <section class="border-b border-[#e8ded6] bg-[#fbf8f5] py-12 sm:py-16 md:py-20">
      <div class="container-elus max-w-4xl">
        <nav class="text-sm text-[#7a8582]" aria-label="Breadcrumb">
          <a href="/" class="transition hover:text-[#338d83]">Início</a>
          <span class="px-2">/</span>
          <a href="/conteudos/" class="transition hover:text-[#338d83]">Conteúdos</a>
        </nav>

        <p class="mt-8 text-sm font-bold uppercase tracking-[0.2em] text-[#338d83]">{category}</p>
        <h1 class="mt-4 max-w-4xl text-4xl font-normal leading-tight tracking-tight text-[#174442] sm:text-5xl md:text-6xl">
          {title}
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-[#6f7774]">{description}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-[#6f7774]">
          <a href="/sobre-jessica/" class="font-semibold text-[#174442] transition hover:text-[#338d83]">
            Jéssica Albuquerque Vasconcelos
          </a>
          <span aria-hidden="true">•</span>
          <span>Psicóloga · {site.crp}</span>
          <span aria-hidden="true">•</span>
          <span>{readTime}</span>
        </div>
      </div>
    </section>

    <section class="bg-white py-12 sm:py-16 md:py-20">
      <div class="container-elus grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-14">
        <article class="article-copy max-w-3xl text-[17px] leading-8 text-[#56615f]">
          <slot />
        </article>

        <aside class="lg:sticky lg:top-28 lg:self-start">
          <div class="rounded-[1.5rem] border border-[#e8ded6] bg-[#fbf8f5] p-6">
            <p class="text-sm font-semibold text-[#174442]">Este conteúdo ajuda a entender o tema, mas não substitui uma avaliação individual.</p>
            <a
              href={serviceHref}
              class="mt-5 inline-flex w-full items-center justify-center rounded-full bg-[#338d83] px-5 py-3 text-center text-sm font-bold text-white transition hover:bg-[#185c58]"
            >
              {serviceLabel}
            </a>
          </div>
        </aside>
      </div>
    </section>

    <section class="border-t border-[#e8ded6] bg-[#fbf8f5] py-12">
      <div class="container-elus max-w-4xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#338d83]">Autoria e responsabilidade técnica</p>
        <div class="mt-5 grid gap-6 sm:grid-cols-[120px_1fr] sm:items-center">
          <img
            src="/images/elus/jessica/jessica-sobre.webp"
            alt="Jéssica Albuquerque Vasconcelos"
            class="h-28 w-28 rounded-full object-cover object-[center_16%]"
            width="224"
            height="224"
            loading="lazy"
          />
          <div>
            <h2 class="text-2xl font-normal text-[#174442]">Jéssica Albuquerque Vasconcelos</h2>
            <p class="mt-2 text-sm leading-6 text-[#6f7774]">Psicóloga clínica e neuropsicóloga · {site.crp}. Responsável pela ELUS Psicologia.</p>
            <a href="/sobre-jessica/" class="mt-3 inline-block text-sm font-semibold text-[#338d83] transition hover:text-[#185c58]">Conhecer formação e trajetória →</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .article-copy :global(h2) {
      margin-top: 2.75rem;
      font-size: 2rem;
      line-height: 1.2;
      font-weight: 400;
      color: #174442;
    }
    .article-copy :global(h3) {
      margin-top: 2rem;
      font-size: 1.35rem;
      line-height: 1.35;
      font-weight: 600;
      color: #174442;
    }
    .article-copy :global(p) { margin-top: 1.25rem; }
    .article-copy :global(ul) { margin-top: 1.25rem; padding-left: 1.25rem; list-style: disc; }
    .article-copy :global(li) { margin-top: .65rem; }
    .article-copy :global(a) { color: #338d83; text-decoration: underline; text-underline-offset: 3px; }
    .article-copy :global(strong) { color: #174442; }
  </style>
</BaseLayout>
