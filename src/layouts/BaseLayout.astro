---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import { site, whatsappLink } from "../config/site";

type Props = {
  title?: string;
  description?: string;
  whatsappHref?: string;
  whatsappService?: string;
  whatsappLabel?: string;
};

const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const activeWhatsappLink = Astro.props.whatsappHref ?? whatsappLink;
const whatsappService = Astro.props.whatsappService ?? "general";
const whatsappLabel = Astro.props.whatsappLabel ?? "Falar no WhatsApp";
const canonicalURL = new URL(Astro.url.pathname, site.url);
const logoURL = new URL("/images/elus/brand/logo-elus-transparent.png", site.url);
const googleTagURL = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(site.analyticsMeasurementId)}`;
const isProduction = import.meta.env.PROD;
const phoneDigits = String(site.phone).replace(/\D/g, "");
const internationalPhone = phoneDigits.startsWith("55") ? `+${phoneDigits}` : `+55${phoneDigits}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: site.url,
  logo: logoURL.href,
  image: logoURL.href,
  description: site.description,
  email: site.email,
  telephone: internationalPhone,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Avenida Ator José Wilker, 605",
    addressLocality: "Rio de Janeiro",
    addressRegion: "RJ",
    postalCode: "22775-024",
    addressCountry: "BR",
  },
  areaServed: ["Centro Metropolitano", "Barra Olímpica", "Jacarepaguá", "Barra da Tijuca", "Rio de Janeiro"],
  employee: {
    "@type": "Person",
    name: site.professionalName,
    jobTitle: "Psicóloga clínica e neuropsicóloga",
  },
  sameAs: [site.instagram],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" sizes="96x96" href="/elus-favicon-2026.png" />
    <link rel="icon" type="image/x-icon" href="/elus-favicon-2026.ico" />
    <link rel="shortcut icon" href="/elus-favicon-2026.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/elus-apple-touch-2026.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={logoURL.href} />
    <meta property="og:locale" content="pt_BR" />

    <meta name="theme-color" content="#fbf8f5" />

    {isProduction && (
      <>
        <!-- ELUS Measurement: Consent Mode v2 starts before the Google tag. -->
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function gtag(){ dataLayer.push(arguments); };

          (function initializeElusConsent(){
            var savedConsent = null;
            try {
              savedConsent = localStorage.getItem("elus-analytics-consent");
            } catch (_) {
              savedConsent = null;
            }

            var measurementConsent = savedConsent === "accepted" ? "granted" : "denied";
            var consentDefaults = {
              analytics_storage: measurementConsent,
              ad_storage: measurementConsent,
              ad_user_data: measurementConsent,
              ad_personalization: "denied"
            };

            if (!savedConsent) consentDefaults.wait_for_update = 500;
            window.gtag("consent", "default", consentDefaults);
          })();
        </script>
        <script is:inline async src={googleTagURL}></script>
        <script is:inline define:vars={{ measurementId: site.analyticsMeasurementId }}>
          window.gtag("js", new Date());
          window.gtag("config", measurementId, {
            send_page_view: true,
            allow_ad_personalization_signals: false,
            allow_google_signals: false
          });
        </script>
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <Header whatsappHref={activeWhatsappLink} whatsappService={whatsappService} />
    <slot />
    <Footer whatsappHref={activeWhatsappLink} whatsappService={whatsappService} />
    <AnalyticsConsent />

    <a
      href={activeWhatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      data-whatsapp-cta
      data-cta-location="floating_desktop"
      data-service={whatsappService}
      class="floating-whatsapp fixed right-5 z-40 hidden items-center gap-2 rounded-full bg-[#338d83] px-5 py-3 text-sm font-bold text-white shadow-xl shadow-[#174442]/20 transition hover:-translate-y-0.5 hover:bg-[#185c58] sm:inline-flex"
      aria-label={`${whatsappLabel} — Elus Psicologia`}
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
        <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.45L3 20.5l1.55-5.15A8.5 8.5 0 1 1 21 11.5Z" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M8.4 8.3c.35 2.7 2.55 4.9 5.3 5.3" stroke-linecap="round" />
      </svg>
      <span>{whatsappLabel}</span>
    </a>

    <a
      id="mobile-whatsapp-sticky"
      href={activeWhatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      data-whatsapp-cta
      data-cta-location="sticky_mobile"
      data-service={whatsappService}
      class="mobile-whatsapp-sticky pointer-events-none fixed inset-x-7 z-40 flex translate-y-4 items-center justify-center gap-2 rounded-full bg-[#338d83] px-4 py-3 text-[13px] font-bold text-white opacity-0 shadow-xl shadow-[#174442]/20 transition duration-200 sm:hidden"
      aria-label={`${whatsappLabel} — Elus Psicologia`}
      aria-hidden="true"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
        <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.45L3 20.5l1.55-5.15A8.5 8.5 0 1 1 21 11.5Z" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M8.4 8.3c.35 2.7 2.55 4.9 5.3 5.3" stroke-linecap="round" />
      </svg>
      {whatsappLabel}
    </a>

    <div class="h-20 sm:hidden" aria-hidden="true"></div>

    <script>
      function initStickyWhatsApp() {
        const sticky = document.querySelector<HTMLElement>("#mobile-whatsapp-sticky");
        if (!sticky || sticky.dataset.initialized === "true") return;
        sticky.dataset.initialized = "true";

        const inlineCtas = Array.from(
          document.querySelectorAll<HTMLElement>("main [data-whatsapp-cta]")
        );
        let inlineCtaVisible = inlineCtas.some((cta) => {
          const rect = cta.getBoundingClientRect();
          return rect.top < window.innerHeight && rect.bottom > 0;
        });

        const setSticky = (show: boolean) => {
          const canShow = show && !document.documentElement.classList.contains("menu-open");
          sticky.classList.toggle("pointer-events-none", !canShow);
          sticky.classList.toggle("opacity-0", !canShow);
          sticky.classList.toggle("translate-y-4", !canShow);
          sticky.classList.toggle("pointer-events-auto", canShow);
          sticky.classList.toggle("opacity-100", canShow);
          sticky.classList.toggle("translate-y-0", canShow);
          sticky.setAttribute("aria-hidden", String(!canShow));
        };

        const update = () => {
          if (window.innerWidth >= 640) {
            setSticky(false);
            return;
          }
          const enoughScroll = window.scrollY > 180;
          setSticky(enoughScroll && !inlineCtaVisible);
        };

        if (inlineCtas.length) {
          const visibility = new Map<HTMLElement, boolean>();
          inlineCtas.forEach((cta) => visibility.set(cta, false));

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                visibility.set(entry.target as HTMLElement, entry.isIntersecting);
              });
              inlineCtaVisible = Array.from(visibility.values()).some(Boolean);
              update();
            },
            { threshold: 0.25 }
          );
          inlineCtas.forEach((cta) => observer.observe(cta));
        }

        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);

        const menuObserver = new MutationObserver(update);
        menuObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        update();
      }

      initStickyWhatsApp();
      document.addEventListener("astro:page-load", initStickyWhatsApp);
    </script>
  </body>
</html>
