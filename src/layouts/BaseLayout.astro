---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import { site, whatsappLink } from "../config/site";

type Props = {
  title?: string;
  description?: string;
};

const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const canonicalURL = new URL(Astro.url.pathname, site.url);
const logoURL = new URL("/logo-elus.png", site.url);
const phoneDigits = String(site.phone).replace(/\D/g, "");
const internationalPhone = phoneDigits.startsWith("55") ? `+${phoneDigits}` : `+55${phoneDigits}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: site.url,
  logo: logoURL.href,
  image: logoURL.href,
  description: site.description,
  email: site.email,
  telephone: internationalPhone,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Avenida Ator José Wilker, 605",
    addressLocality: "Rio de Janeiro",
    addressRegion: "RJ",
    postalCode: "22775-024",
    addressCountry: "BR",
  },
  areaServed: ["Centro Metropolitano", "Barra Olímpica", "Jacarepaguá", "Barra da Tijuca", "Rio de Janeiro"],
  employee: {
    "@type": "Person",
    name: site.professionalName,
    jobTitle: "Psicóloga clínica e neuropsicóloga",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Serviços psicológicos",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Psicoterapia" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Avaliação Neuropsicológica" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Atendimento psicológico online" } },
    ],
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "13:00",
    },
  ],
  sameAs: [site.instagram],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={logoURL.href} />
    <meta property="og:locale" content="pt_BR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoURL.href} />
    <meta name="theme-color" content="#338d83" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <Header />
    <slot />
    <Footer />
    <AnalyticsConsent />

    <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="fixed bottom-5 right-5 z-40 inline-flex items-center gap-2 rounded-full bg-[#338d83] px-5 py-3 text-sm font-bold text-white shadow-xl shadow-[#174442]/20 transition hover:-translate-y-0.5 hover:bg-[#185c58]" aria-label="Falar com a Elus Psicologia pelo WhatsApp">
      <span aria-hidden="true">💬</span>
      <span class="hidden sm:inline">Falar no WhatsApp</span>
    </a>
  </body>
</html>
