---
import BaseLayout from "../layouts/BaseLayout.astro";
import { whatsappLink } from "../config/site";

const supports = [
  "Ansiedade, sobrecarga e dificuldades emocionais.",
  "Mudanças de vida, conflitos e relacionamentos.",
  "Autoconhecimento e desenvolvimento de recursos pessoais.",
  "Dificuldades de organização emocional e rotina.",
  "Orientação parental e apoio a famílias.",
  "Acompanhamento de pessoas neurodivergentes.",
];

const faqs = [
  {
    question: "Como funciona a primeira sessão?",
    answer:
      "A primeira sessão é um encontro de acolhimento e compreensão da demanda. Você não precisa chegar com tudo organizado: a conversa ajuda a identificar necessidades, expectativas e próximos passos.",
  },
  {
    question: "A psicoterapia tem duração definida?",
    answer:
      "A duração varia de acordo com a demanda, os objetivos e o desenvolvimento do processo. O acompanhamento é revisto ao longo do tempo, com clareza e diálogo.",
  },
  {
    question: "O atendimento pode ser presencial ou online?",
    answer:
      "Sim. A modalidade é definida considerando preferência, disponibilidade e adequação ao caso. O atendimento presencial acontece no Centro Metropolitano, próximo à Barra da Tijuca e Barra Olímpica.",
  },
  {
    question: "Como saber se é o momento de procurar ajuda?",
    answer:
      "Não é necessário esperar uma situação se agravar. A psicoterapia pode ser procurada quando emoções, pensamentos, relações ou situações da vida estão causando sofrimento ou limitando o bem-estar.",
  },
];
---

<BaseLayout
  title="Psicoterapia no Centro Metropolitano e Online | Elus Psicologia"
  description="Psicoterapia para adultos, adolescentes e famílias, presencial no Centro Metropolitano, próximo à Barra da Tijuca e Barra Olímpica, e também online."
>
  <main class="pt-20">
    <section class="container-elus grid items-center gap-12 py-16 md:grid-cols-[1.05fr_0.95fr] md:py-24">
      <div>
        <p class="mb-5 inline-flex rounded-full border border-[#e8ded6] bg-white px-4 py-2 text-sm font-medium text-[#338d83]">
          Psicoterapia presencial e online
        </p>

        <h1 class="max-w-3xl text-5xl font-normal leading-tight tracking-tight text-[#174442] md:text-6xl">
          Um espaço para compreender, elaborar e construir novos caminhos<span class="text-[#f4b3e1]">.</span>
        </h1>

        <p class="mt-8 max-w-2xl text-base leading-8 text-[#6f7774] md:text-lg">
          A psicoterapia é um processo de cuidado psicológico conduzido com escuta,
          ética e respeito à singularidade de cada pessoa. Na ELUS, o atendimento é
          realizado com clareza, acolhimento e responsabilidade técnica.
        </p>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#338d83] px-7 py-4 text-center text-sm font-semibold text-white shadow-lg shadow-[#338d83]/20 transition hover:bg-[#185c58]">
            Consultar horários
          </a>
          <a href="#como-funciona" class="rounded-full border border-[#338d83]/50 bg-white px-7 py-4 text-center text-sm font-semibold text-[#338d83] transition hover:bg-[#f3eeea]">
            Como funciona
          </a>
        </div>
      </div>

      <div class="soft-shadow overflow-hidden rounded-[3rem] bg-[#f3eeea]">
        <img src="/consultorio-adulto.jpg" alt="Consultório para psicoterapia da ELUS Psicologia" class="h-full min-h-[480px] w-full object-cover" loading="eager" />
      </div>
    </section>

    <section class="border-y border-[#e8ded6] bg-white py-20">
      <div class="container-elus grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Quando pode ajudar</p>
          <h2 class="mt-4 text-4xl font-normal leading-tight text-[#174442] md:text-5xl">Demandas que podem ser acolhidas.</h2>
          <div class="mt-5 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {supports.map((item) => (
            <article class="rounded-[1.5rem] bg-[#fbf8f5] p-6">
              <span class="text-xl text-[#338d83]">♡</span>
              <p class="mt-3 text-sm leading-7 text-[#6f7774]">{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="como-funciona" class="bg-[#fbf8f5] py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Como funciona</p>
          <h2 class="mt-4 text-4xl font-normal text-[#174442] md:text-5xl">Do primeiro contato ao acompanhamento.</h2>
          <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          <article class="card-border rounded-[1.75rem] bg-white p-8">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#338d83] text-sm font-bold text-white">1</span>
            <h3 class="mt-6 text-2xl font-normal text-[#174442]">Contato inicial</h3>
            <p class="mt-4 text-sm leading-7 text-[#6f7774]">Você entra em contato pelo WhatsApp, informa a modalidade de interesse e consulta os horários disponíveis.</p>
          </article>

          <article class="card-border rounded-[1.75rem] bg-white p-8">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#338d83] text-sm font-bold text-white">2</span>
            <h3 class="mt-6 text-2xl font-normal text-[#174442]">Primeira sessão</h3>
            <p class="mt-4 text-sm leading-7 text-[#6f7774]">A conversa inicial permite compreender a demanda, conhecer a história e avaliar a forma mais adequada de cuidado.</p>
          </article>

          <article class="card-border rounded-[1.75rem] bg-white p-8">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#338d83] text-sm font-bold text-white">3</span>
            <h3 class="mt-6 text-2xl font-normal text-[#174442]">Processo terapêutico</h3>
            <p class="mt-4 text-sm leading-7 text-[#6f7774]">Os encontros seguem objetivos construídos em conjunto, respeitando ritmo, necessidades e singularidades.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-white py-20">
      <div class="container-elus grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="overflow-hidden rounded-[2rem] bg-[#f3eeea] soft-shadow">
          <img src="/jessica-albuquerque.jpg" alt="Jéssica Albuquerque Vasconcelos, psicóloga responsável pela Elus Psicologia" class="h-full min-h-[500px] w-full object-cover object-top" loading="lazy" />
        </div>

        <div>
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Profissional responsável</p>
          <h2 class="mt-4 text-4xl font-normal leading-tight text-[#174442] md:text-5xl">Cuidado conduzido com técnica e sensibilidade.</h2>
          <p class="mt-7 text-base leading-8 text-[#6f7774]">Jéssica Albuquerque Vasconcelos é psicóloga clínica e neuropsicóloga. Atua com adultos, adolescentes, famílias e pessoas neurodivergentes, integrando escuta acolhedora, responsabilidade técnica e orientação parental.</p>
          <a href="/sobre-jessica" class="mt-8 inline-flex rounded-full border border-[#338d83]/50 bg-white px-7 py-4 text-sm font-semibold text-[#338d83] transition hover:bg-[#f3eeea]">Conhecer a trajetória da Jéssica</a>
        </div>
      </div>
    </section>

    <section class="bg-[#fbf8f5] py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Dúvidas frequentes</p>
          <h2 class="mt-4 text-4xl font-normal text-[#174442] md:text-5xl">Antes de iniciar.</h2>
        </div>

        <div class="mx-auto mt-12 grid max-w-5xl gap-4 md:grid-cols-2">
          {faqs.map((faq) => (
            <details class="rounded-[1.25rem] border border-[#e8ded6] bg-white p-5 shadow-sm">
              <summary class="cursor-pointer list-none font-semibold text-[#174442]">{faq.question}</summary>
              <p class="mt-4 text-sm leading-7 text-[#6f7774]">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white pb-20">
      <div class="container-elus">
        <div class="relative overflow-hidden rounded-[2rem] bg-[#338d83] p-9 text-white md:p-12">
          <div class="relative flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
            <div>
              <h2 class="text-4xl font-normal">Quer conversar sobre psicoterapia?</h2>
              <p class="mt-3 max-w-xl text-white/85">Entre em contato para tirar dúvidas e consultar a disponibilidade de horários.</p>
            </div>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white px-7 py-4 text-sm font-bold text-[#338d83] transition hover:bg-[#f3eeea]">Falar com a ELUS</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
