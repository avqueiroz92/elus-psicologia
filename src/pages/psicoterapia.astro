---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappLink } from "../config/site";

const supports = [
  "Ansiedade, sobrecarga e dificuldades emocionais.",
  "Mudanças de vida, conflitos e relacionamentos.",
  "Autoconhecimento e desenvolvimento de recursos pessoais.",
  "Dificuldades de organização emocional e rotina.",
  "Orientação parental e apoio a famílias.",
  "Acompanhamento de pessoas neurodivergentes.",
];

const faqs = [
  {
    question: "Como funciona a primeira sessão?",
    answer:
      "A primeira sessão é um encontro de acolhimento e compreensão da demanda. Você não precisa chegar com tudo organizado: a conversa ajuda a identificar necessidades, expectativas e próximos passos.",
  },
  {
    question: "A psicoterapia tem duração definida?",
    answer:
      "A duração varia de acordo com a demanda, os objetivos e o desenvolvimento do processo. O acompanhamento é revisto ao longo do tempo, com clareza e diálogo.",
  },
  {
    question: "O atendimento pode ser presencial ou online?",
    answer:
      "Sim. A modalidade é definida considerando preferência, disponibilidade e adequação ao caso. O atendimento presencial acontece no Centro Metropolitano, próximo à Barra da Tijuca e Barra Olímpica.",
  },
  {
    question: "Como saber se é o momento de procurar ajuda?",
    answer:
      "Não é necessário esperar uma situação se agravar. A psicoterapia pode ser procurada quando emoções, pensamentos, relações ou situações da vida estão causando sofrimento ou limitando o bem-estar.",
  },
];
---

<BaseLayout
  title="Psicoterapia no Centro Metropolitano e Online | Elus Psicologia"
  description="Psicoterapia para crianças, adolescentes e adultos, presencial no Centro Metropolitano, próximo à Barra da Tijuca e Barra Olímpica, e também online."
>
  <main class="pt-16 sm:pt-20">
    <section class="container-elus grid items-center gap-7 py-7 sm:gap-10 sm:py-12 lg:grid-cols-[1.03fr_0.97fr] lg:gap-12 lg:py-20">
      <div>
        <p class="mb-3 inline-flex rounded-full border border-[#e8ded6] bg-white px-3.5 py-2 text-[13px] font-medium text-[#338d83] sm:mb-5 sm:px-4 sm:text-sm">
          Psicoterapia presencial e online
        </p>

        <h1 class="hero-title-mobile max-w-3xl font-normal text-[#174442] md:text-6xl md:leading-tight">
          Psicoterapia no Centro Metropolitano e online<span class="text-[#f4b3e1]">.</span>
        </h1>

        <p class="mt-5 max-w-2xl text-[15px] leading-7 text-[#6f7774] sm:mt-7 sm:text-base sm:leading-8 md:text-lg">
          Atendimento com {site.professionalName}, Psicóloga, {site.crp}, para crianças, adolescentes e adultos, com escuta, ética e respeito à singularidade de cada pessoa.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:gap-4">
          <a
            data-primary-whatsapp-cta
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-[#338d83] px-7 py-4 text-center text-sm font-semibold text-white shadow-lg shadow-[#338d83]/20 transition hover:bg-[#185c58]"
          >
            Consultar horários no WhatsApp
          </a>
          <a href="#como-funciona" class="rounded-full border border-[#338d83]/50 bg-white px-7 py-4 text-center text-sm font-semibold text-[#338d83] transition hover:bg-[#f3eeea]">
            Como funciona
          </a>
        </div>

        <div class="mt-5 flex flex-wrap gap-2 text-xs text-[#5d6865] sm:mt-7">
          <span class="rounded-full border border-[#e8ded6] bg-white px-3 py-2">Centro Metropolitano</span>
          <span class="rounded-full border border-[#e8ded6] bg-white px-3 py-2">Presencial e online</span>
          <span class="rounded-full border border-[#e8ded6] bg-white px-3 py-2">Crianças a adultos</span>
        </div>
      </div>

      <figure class="soft-shadow mt-2 overflow-hidden rounded-[1.75rem] bg-[#f3eeea] sm:rounded-[2.5rem] lg:mt-0">
        <img
          src="/images/elus/espaco/consultorio-adulto.webp"
          alt="Consultório para psicoterapia da ELUS Psicologia"
          class="aspect-[4/3] w-full object-cover object-center sm:aspect-[5/4] lg:min-h-[500px]"
          width="1200"
          height="900"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="mobile-section border-y border-[#e8ded6] bg-white py-20">
      <div class="container-elus grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.20em] text-[#338d83] sm:text-sm sm:tracking-[0.22em]">Quando pode ajudar</p>
          <h2 class="mt-3 text-4xl font-normal leading-tight text-[#174442] md:mt-4 md:text-5xl">Demandas que podem ser acolhidas.</h2>
          <div class="mt-4 h-1 w-16 rounded-full bg-[#f4b3e1] sm:mt-5"></div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
          {supports.map((item) => (
            <article class="flex items-start gap-3 rounded-[1.25rem] bg-[#fbf8f5] p-4 sm:block sm:rounded-[1.5rem] sm:p-6">
              <span class="mt-0.5 text-xl text-[#338d83] sm:mt-0">♡</span>
              <p class="text-sm leading-6 text-[#6f7774] sm:mt-3 sm:leading-7">{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="como-funciona" class="mobile-section bg-[#fbf8f5] py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-bold uppercase tracking-[0.20em] text-[#338d83] sm:text-sm sm:tracking-[0.22em]">Como funciona</p>
          <h2 class="mt-3 text-4xl font-normal text-[#174442] md:mt-4 md:text-5xl">Do primeiro contato ao acompanhamento.</h2>
          <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>

        <div class="mt-9 grid gap-4 sm:mt-14 sm:gap-6 md:grid-cols-3">
          <article class="card-border rounded-[1.5rem] bg-white p-5 sm:rounded-[1.75rem] sm:p-8">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#338d83] text-sm font-bold text-white sm:h-10 sm:w-10">1</span>
            <h3 class="mt-4 text-2xl font-normal text-[#174442] sm:mt-6">Contato inicial</h3>
            <p class="mt-3 text-sm leading-6 text-[#6f7774] sm:mt-4 sm:leading-7">Você entra em contato pelo WhatsApp, informa a modalidade de interesse e consulta os horários disponíveis.</p>
          </article>

          <article class="card-border rounded-[1.5rem] bg-white p-5 sm:rounded-[1.75rem] sm:p-8">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#338d83] text-sm font-bold text-white sm:h-10 sm:w-10">2</span>
            <h3 class="mt-4 text-2xl font-normal text-[#174442] sm:mt-6">Primeira sessão</h3>
            <p class="mt-3 text-sm leading-6 text-[#6f7774] sm:mt-4 sm:leading-7">A conversa inicial permite compreender a demanda, conhecer a história e avaliar a forma mais adequada de cuidado.</p>
          </article>

          <article class="card-border rounded-[1.5rem] bg-white p-5 sm:rounded-[1.75rem] sm:p-8">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#338d83] text-sm font-bold text-white sm:h-10 sm:w-10">3</span>
            <h3 class="mt-4 text-2xl font-normal text-[#174442] sm:mt-6">Processo terapêutico</h3>
            <p class="mt-3 text-sm leading-6 text-[#6f7774] sm:mt-4 sm:leading-7">Os encontros seguem objetivos construídos em conjunto, respeitando ritmo, necessidades e singularidades.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="mobile-section bg-white py-20">
      <div class="container-elus grid items-center gap-7 sm:gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="soft-shadow order-2 overflow-hidden rounded-[1.75rem] bg-[#f3eeea] sm:rounded-[2rem] lg:order-1">
          <img
            src="/images/elus/jessica/jessica-avaliacao-infantil.webp"
            alt="Jéssica Albuquerque Vasconcelos em ambiente acolhedor da ELUS Psicologia"
            class="h-[360px] w-full object-cover object-[center_20%] sm:min-h-[520px] sm:object-[center_18%] lg:h-full"
            width="960"
            height="1200"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="order-1 lg:order-2">
          <p class="text-xs font-bold uppercase tracking-[0.20em] text-[#338d83] sm:text-sm sm:tracking-[0.22em]">Profissional responsável</p>
          <h2 class="mt-3 text-4xl font-normal leading-tight text-[#174442] md:mt-4 md:text-5xl">Cuidado conduzido com técnica e sensibilidade.</h2>
          <p class="mt-5 text-[15px] leading-7 text-[#6f7774] sm:mt-7 sm:text-base sm:leading-8">Jéssica Albuquerque Vasconcelos é psicóloga clínica e neuropsicóloga. Atua com crianças, adolescentes, adultos, famílias e pessoas neurodivergentes, integrando escuta acolhedora, responsabilidade técnica e orientação parental.</p>
          <p class="mt-3 text-sm font-medium text-[#338d83]">{site.crp}</p>
          <a href="/sobre-jessica" class="mt-6 inline-flex rounded-full border border-[#338d83]/50 bg-white px-7 py-4 text-sm font-semibold text-[#338d83] transition hover:bg-[#f3eeea] sm:mt-8">Conhecer a trajetória da Jéssica</a>
        </div>
      </div>
    </section>

    <section class="mobile-section bg-[#fbf8f5] py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-bold uppercase tracking-[0.20em] text-[#338d83] sm:text-sm sm:tracking-[0.22em]">Dúvidas frequentes</p>
          <h2 class="mt-3 text-4xl font-normal text-[#174442] md:mt-4 md:text-5xl">Antes de iniciar.</h2>
        </div>

        <div class="mx-auto mt-8 grid max-w-5xl gap-3 sm:mt-12 sm:gap-4 md:grid-cols-2">
          {faqs.map((faq) => (
            <details class="rounded-[1.25rem] border border-[#e8ded6] bg-white p-5 shadow-sm">
              <summary class="flex min-h-8 cursor-pointer list-none items-center justify-between gap-4 font-semibold text-[#174442]">
                {faq.question}
                <span class="text-xl font-normal text-[#338d83]" aria-hidden="true">+</span>
              </summary>
              <p class="mt-4 text-sm leading-7 text-[#6f7774]">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white pb-12 sm:pb-20">
      <div class="container-elus">
        <div class="relative overflow-hidden rounded-[1.75rem] bg-[#338d83] p-7 text-white sm:rounded-[2rem] sm:p-9 md:p-12">
          <div class="relative flex flex-col items-start justify-between gap-6 md:flex-row md:items-center md:gap-8">
            <div>
              <h2 class="text-4xl font-normal">Quer conversar sobre psicoterapia?</h2>
              <p class="mt-3 max-w-xl text-sm leading-6 text-white/85 sm:text-base sm:leading-7">Entre em contato para tirar dúvidas e consultar a disponibilidade de horários.</p>
            </div>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="w-full rounded-full bg-white px-7 py-4 text-center text-sm font-bold text-[#338d83] transition hover:bg-[#f3eeea] sm:w-auto">Falar com a ELUS</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
