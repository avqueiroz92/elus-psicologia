---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappLink } from "../config/site";

const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.location)}`;

const spaces = [
  {
    title: "Recepção",
    subtitle: "Um espaço confortável para a chegada.",
    image: "/images/elus/espaco/recepcao.webp",
    alt: "Recepção da ELUS Psicologia com poltronas, plantas e identidade visual da clínica",
    description:
      "A recepção foi organizada para a espera antes do atendimento, com assentos e um ambiente tranquilo.",
  },
  {
    title: "Consultório",
    subtitle: "Privacidade para os atendimentos.",
    image: "/images/elus/espaco/consultorio-adulto.webp",
    alt: "Consultório da ELUS Psicologia preparado para psicoterapia e avaliação",
    description:
      "O consultório é utilizado para psicoterapia, conversas com responsáveis e etapas da avaliação neuropsicológica.",
  },
  {
    title: "Espaço infantil",
    subtitle: "Um ambiente preparado para crianças.",
    image: "/images/elus/espaco/espaco-infantil.webp",
    alt: "Espaço infantil da ELUS Psicologia com mesa, brinquedos e decoração lúdica",
    description:
      "O espaço infantil conta com recursos compatíveis com o atendimento de crianças e diferentes formas de expressão durante o processo terapêutico.",
    href: "/psicoterapia-infantil",
    linkLabel: "Conhecer a psicoterapia infantil →",
  },
];
---

<BaseLayout
  title="Conheça a ELUS Psicologia | Centro Metropolitano, Rio de Janeiro"
  description="Conheça o consultório da ELUS Psicologia no Centro Metropolitano, próximo à Barra da Tijuca, Barra Olímpica e aos bairros da região."
>
  <main class="pt-20">
    <section class="container-elus grid items-center gap-12 py-16 lg:grid-cols-[0.92fr_1.08fr] lg:py-24">
      <div>
        <p class="mb-5 inline-flex rounded-full border border-[#e8ded6] bg-white px-4 py-2 text-sm font-medium text-[#338d83]">Conheça a ELUS</p>
        <h1 class="max-w-3xl text-5xl font-normal leading-tight tracking-tight text-[#174442] md:text-6xl">
          Nosso espaço no Centro Metropolitano<span class="text-[#f4b3e1]">.</span>
        </h1>
        <p class="mt-8 max-w-2xl text-base leading-8 text-[#6f7774] md:text-lg">
          A ELUS é o consultório onde Jéssica Albuquerque Vasconcelos realiza atendimentos presenciais de psicoterapia, psicoterapia infantil e avaliação neuropsicológica. O espaço fica no Centro Metropolitano, próximo à Barra Olímpica, Barra da Tijuca e Jacarepaguá.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a data-whatsapp-cta data-cta-location="hero" href={whatsappLink} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#338d83] px-7 py-4 text-center text-sm font-semibold text-white shadow-lg shadow-[#338d83]/20 transition hover:bg-[#185c58]">Consultar horários</a>
          <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="rounded-full border border-[#338d83]/50 bg-white px-7 py-4 text-center text-sm font-semibold text-[#338d83] transition hover:bg-[#f3eeea]">Ver rota</a>
        </div>
      </div>

      <figure class="soft-shadow overflow-hidden rounded-[2.5rem] bg-[#f3eeea]">
        <img src="/images/elus/espaco/acolhimento-janela.webp" alt="Ambiente da ELUS Psicologia no Centro Metropolitano com luz natural" class="aspect-[4/3] h-full w-full object-cover object-center" width="1200" height="800" loading="eager" fetchpriority="high" />
      </figure>
    </section>

    <section class="border-y border-[#e8ded6] bg-white py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">O espaço</p>
          <h2 class="mt-4 text-4xl font-normal leading-tight text-[#174442] md:text-5xl">Recepção, consultório e espaço infantil.</h2>
          <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {spaces.map((space) => (
            <article class="card-border soft-shadow overflow-hidden rounded-[2rem] bg-white">
              <div class="overflow-hidden bg-[#f3eeea]">
                <img src={space.image} alt={space.alt} class="aspect-[4/3] w-full object-cover object-center" width="1200" height="900" loading="lazy" decoding="async" />
              </div>
              <div class="p-7">
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#338d83]">{space.title}</p>
                <h3 class="mt-3 text-2xl font-normal leading-tight text-[#174442]">{space.subtitle}</h3>
                <p class="mt-4 text-sm leading-7 text-[#6f7774]">{space.description}</p>
                {space.href && <a href={space.href} class="mt-5 inline-flex text-sm font-semibold text-[#338d83]">{space.linkLabel}</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#fbf8f5] py-20">
      <div class="container-elus grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <article class="card-border rounded-[2rem] bg-white p-8 soft-shadow md:p-10">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Atendimentos</p>
          <h2 class="mt-4 text-4xl font-normal leading-tight text-[#174442]">O consultório da Jéssica.</h2>
          <p class="mt-7 text-base leading-8 text-[#6f7774]">
            Jéssica atende crianças, adolescentes e adultos. Dependendo da demanda, os encontros podem envolver também responsáveis ou outros profissionais, sempre de acordo com o atendimento realizado.
          </p>
          <ul class="mt-7 space-y-4 text-sm leading-7 text-[#6f7774]">
            <li class="flex gap-3"><span class="text-[#338d83]">●</span>Psicoterapia presencial e online.</li>
            <li class="flex gap-3"><span class="text-[#338d83]">●</span>Psicoterapia infantil e orientação aos responsáveis quando indicada.</li>
            <li class="flex gap-3"><span class="text-[#338d83]">●</span>Avaliação neuropsicológica.</li>
          </ul>
          <div class="mt-8 border-t border-[#e8ded6] pt-6">
            <p class="text-sm leading-7 text-[#6f7774]">Atendimentos com <strong class="text-[#174442]">{site.professionalName}</strong>, Psicóloga, {site.crp}.</p>
            <a href="/sobre-jessica" class="mt-4 inline-flex text-sm font-semibold text-[#338d83]">Conhecer a Jéssica →</a>
          </div>
        </article>

        <article class="card-border rounded-[2rem] bg-white p-8 soft-shadow md:p-10">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Como chegar</p>
          <h2 class="mt-4 text-4xl font-normal leading-tight text-[#174442]">Centro Metropolitano.</h2>
          <dl class="mt-7 space-y-6 text-sm leading-7 text-[#6f7774]">
            <div><dt class="font-semibold text-[#174442]">Endereço</dt><dd>{site.location}</dd></div>
            <div><dt class="font-semibold text-[#174442]">Região</dt><dd>{site.locationContext}</dd></div>
            <div><dt class="font-semibold text-[#174442]">Horários</dt><dd>Segunda a sexta, das 8h às 18h. Sábado, das 9h às 13h.</dd></div>
            <div><dt class="font-semibold text-[#174442]">Atendimento</dt><dd>Presencial mediante agendamento. Modalidade online também disponível.</dd></div>
            <div><dt class="font-semibold text-[#174442]">Estacionamento</dt><dd>O Centro Metropolitano conta com estacionamento para visitantes. Consulte no local as tarifas vigentes.</dd></div>
          </dl>
          <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex rounded-full bg-[#338d83] px-7 py-4 text-sm font-semibold text-white transition hover:bg-[#185c58]">Abrir no Google Maps</a>
        </article>
      </div>
    </section>

    <section class="bg-white pb-20">
      <div class="container-elus">
        <div class="relative overflow-hidden rounded-[2rem] bg-[#338d83] p-9 text-white md:p-12">
          <div class="relative flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
            <div>
              <h2 class="text-4xl font-normal">Quer tirar uma dúvida antes de agendar?</h2>
              <p class="mt-3 max-w-xl text-white/85">Fale pelo WhatsApp para consultar horários e entender qual atendimento faz sentido para a sua necessidade.</p>
            </div>
            <a data-whatsapp-cta data-cta-location="final" href={whatsappLink} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white px-7 py-4 text-sm font-bold text-[#338d83] transition hover:bg-[#f3eeea]">Falar pelo WhatsApp</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
