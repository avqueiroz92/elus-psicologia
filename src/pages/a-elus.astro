---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappLink } from "../config/site";

const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.location)}`;

const spaces = [
  {
    title: "Recepção",
    subtitle: "Uma chegada mais tranquila.",
    image: "/images/elus/espaco/recepcao.webp",
    alt: "Recepção da ELUS Psicologia com poltronas, plantas e identidade visual da clínica",
    description:
      "Um ambiente organizado e acolhedor para a chegada e a espera antes do atendimento.",
  },
  {
    title: "Consultório",
    subtitle: "Privacidade e conforto.",
    image: "/images/elus/espaco/consultorio-adulto.webp",
    alt: "Consultório da ELUS Psicologia preparado para psicoterapia e avaliação",
    description:
      "Espaço reservado para psicoterapia, conversas e avaliações com privacidade e cuidado.",
  },
  {
    title: "Espaço infantil",
    subtitle: "Cuidado também pelo brincar.",
    image: "/images/elus/espaco/espaco-infantil.webp",
    alt: "Espaço infantil da ELUS Psicologia com mesa, brinquedos e decoração lúdica",
    description:
      "Ambiente lúdico e preparado para acolher crianças durante o processo de cuidado.",
  },
];
---

<BaseLayout
  title="Conheça a ELUS Psicologia | Centro Metropolitano, Rio de Janeiro"
  description="Conheça o espaço da ELUS Psicologia no Centro Metropolitano, próximo à Barra da Tijuca, Barra Olímpica e aos bairros da região."
>
  <main class="pt-20">
    <section class="container-elus grid items-center gap-12 py-16 lg:grid-cols-[0.92fr_1.08fr] lg:py-24">
      <div>
        <p class="mb-5 inline-flex rounded-full border border-[#e8ded6] bg-white px-4 py-2 text-sm font-medium text-[#338d83]">
          Conheça a ELUS
        </p>

        <h1 class="max-w-3xl text-5xl font-normal leading-tight tracking-tight text-[#174442] md:text-6xl">
          Um espaço pensado para acolher com cuidado e tranquilidade<span class="text-[#f4b3e1]">.</span>
        </h1>

        <p class="mt-8 max-w-2xl text-base leading-8 text-[#6f7774] md:text-lg">
          A ELUS Psicologia foi criada para oferecer uma experiência acolhedora desde a chegada.
          Os ambientes foram organizados para proporcionar privacidade, conforto e segurança em
          diferentes momentos do cuidado.
        </p>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a
            data-whatsapp-cta
            data-cta-location="hero"
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-[#338d83] px-7 py-4 text-center text-sm font-semibold text-white shadow-lg shadow-[#338d83]/20 transition hover:bg-[#185c58]"
          >
            Consultar horários
          </a>

          <a
            href={mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-[#338d83]/50 bg-white px-7 py-4 text-center text-sm font-semibold text-[#338d83] transition hover:bg-[#f3eeea]"
          >
            Ver rota
          </a>
        </div>
      </div>

      <figure class="soft-shadow overflow-hidden rounded-[2.5rem] bg-[#f3eeea]">
        <img
          src="/images/elus/espaco/acolhimento-janela.webp"
          alt="Ambiente da ELUS Psicologia no Centro Metropolitano com luz natural"
          class="aspect-[4/3] h-full w-full object-cover object-center"
          width="1200"
          height="800"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="border-y border-[#e8ded6] bg-white py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">
            O espaço
          </p>

          <h2 class="mt-4 text-4xl font-normal leading-tight text-[#174442] md:text-5xl">
            Ambientes para diferentes momentos do cuidado.
          </h2>

          <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {spaces.map((space) => (
            <article class="card-border soft-shadow overflow-hidden rounded-[2rem] bg-white">
              <div class="overflow-hidden bg-[#f3eeea]">
                <img
                  src={space.image}
                  alt={space.alt}
                  class="aspect-[4/3] w-full object-cover object-center"
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="p-7">
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#338d83]">
                  {space.title}
                </p>

                <h3 class="mt-3 text-2xl font-normal leading-tight text-[#174442]">
                  {space.subtitle}
                </h3>

                <p class="mt-4 text-sm leading-7 text-[#6f7774]">
                  {space.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#fbf8f5] py-20">
      <div class="container-elus grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <article class="card-border rounded-[2rem] bg-white p-8 soft-shadow md:p-10">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">
            Nossa proposta
          </p>

          <h2 class="mt-4 text-4xl font-normal leading-tight text-[#174442]">
            Acolhimento que também está no ambiente.
          </h2>

          <p class="mt-7 text-base leading-8 text-[#6f7774]">
            O espaço físico não substitui a relação terapêutica, mas pode contribuir para que a
            pessoa se sinta mais segura e confortável durante o atendimento.
          </p>

          <ul class="mt-7 space-y-4 text-sm leading-7 text-[#6f7774]">
            <li class="flex gap-3"><span class="text-[#338d83]">●</span>Ambientes reservados e organizados.</li>
            <li class="flex gap-3"><span class="text-[#338d83]">●</span>Espaço preparado para adultos, adolescentes e crianças.</li>
            <li class="flex gap-3"><span class="text-[#338d83]">●</span>Atendimento mediante agendamento.</li>
          </ul>

          <div class="mt-8 border-t border-[#e8ded6] pt-6">
            <p class="text-sm leading-7 text-[#6f7774]">
              O cuidado é conduzido por <strong class="text-[#174442]">Jéssica Albuquerque Vasconcelos</strong>, psicóloga clínica e neuropsicóloga.
            </p>
            <a href="/sobre-jessica" class="mt-4 inline-flex text-sm font-semibold text-[#338d83]">
              Conhecer a profissional responsável →
            </a>
          </div>
        </article>

        <article class="card-border rounded-[2rem] bg-white p-8 soft-shadow md:p-10">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">
            Como chegar
          </p>

          <h2 class="mt-4 text-4xl font-normal leading-tight text-[#174442]">
            Nosso espaço no Centro Metropolitano.
          </h2>

          <dl class="mt-7 space-y-6 text-sm leading-7 text-[#6f7774]">
            <div>
              <dt class="font-semibold text-[#174442]">Endereço</dt>
              <dd>{site.location}</dd>
            </div>

            <div>
              <dt class="font-semibold text-[#174442]">Região</dt>
              <dd>{site.locationContext}</dd>
            </div>

            <div>
              <dt class="font-semibold text-[#174442]">Horários</dt>
              <dd>Segunda a sexta, das 8h às 18h. Sábado, das 9h às 13h.</dd>
            </div>

            <div>
              <dt class="font-semibold text-[#174442]">Atendimento</dt>
              <dd>Atendimento presencial mediante agendamento. Modalidade online também disponível.</dd>
            </div>

            <div>
              <dt class="font-semibold text-[#174442]">Estacionamento</dt>
              <dd>O Centro Metropolitano conta com estacionamento para visitantes. Consulte no local as tarifas vigentes.</dd>
            </div>
          </dl>

          <a
            href={mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex rounded-full bg-[#338d83] px-7 py-4 text-sm font-semibold text-white transition hover:bg-[#185c58]"
          >
            Abrir no Google Maps
          </a>
        </article>
      </div>
    </section>

    <section class="bg-white pb-20">
      <div class="container-elus">
        <div class="relative overflow-hidden rounded-[2rem] bg-[#338d83] p-9 text-white md:p-12">
          <div class="relative flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
            <div>
              <h2 class="text-4xl font-normal">Quer conhecer a ELUS?</h2>
              <p class="mt-3 max-w-xl text-white/85">
                Entre em contato para tirar dúvidas sobre os atendimentos e consultar horários.
              </p>
            </div>

            <a
              data-whatsapp-cta
              data-cta-location="final"
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-white px-7 py-4 text-sm font-bold text-[#338d83] transition hover:bg-[#f3eeea]"
            >
              Falar com a ELUS
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
