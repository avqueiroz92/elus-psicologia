---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappLink } from "../config/site";

const services = [
  {
    title: "Psicoterapia",
    icon: "💬",
    color: "bg-[#338d83]",
    href: "/psicoterapia",
    description: "Um processo de cuidado para compreender emoções, relações e experiências com acolhimento e clareza.",
  },
  {
    title: "Psicoterapia Infantil",
    icon: "✦",
    color: "bg-[#f4b3e1]",
    href: "/psicoterapia-infantil",
    description: "Acompanhamento psicológico infantil com recursos adequados à faixa etária e participação dos responsáveis quando indicada.",
  },
  {
    title: "Avaliação Neuropsicológica",
    icon: "📋",
    color: "bg-[#bfa5ed]",
    href: "/avaliacao-neuropsicologica",
    description: "Avaliação de funções cognitivas, emocionais e comportamentais, com instrumentos adequados e devolutiva cuidadosa.",
  },
  {
    title: "Atendimento Online",
    icon: "◉",
    color: "bg-[#4e7cc6]",
    href: "/atendimento-online",
    description: "Psicoterapia por videochamada, com sigilo, flexibilidade e avaliação da adequação para cada caso.",
  },
];

const steps = [
  { number: "1", title: "Entre em contato", text: "Fale com a ELUS pelo WhatsApp e informe o atendimento de interesse.", icon: "📅" },
  { number: "2", title: "Conversa inicial", text: "Compreendemos sua necessidade e orientamos sobre modalidade e horários.", icon: "💬" },
  { number: "3", title: "Inicie o processo", text: "O cuidado é conduzido de acordo com sua demanda e singularidade.", icon: "🌿" },
];
---

<BaseLayout
  title="Psicóloga na Barra Olímpica | Psicoterapia e Neuropsicologia | Elus"
  description="Psicoterapia, psicoterapia infantil e avaliação neuropsicológica com Jéssica Albuquerque Vasconcelos no Centro Metropolitano, na Barra Olímpica, próxima à Barra da Tijuca e Jacarepaguá."
>
  <main id="inicio" class="pt-16 sm:pt-20">
    <section class="container-elus grid min-h-[calc(100svh-64px)] items-center gap-8 py-7 sm:min-h-0 sm:py-12 lg:min-h-[calc(100vh-80px)] lg:grid-cols-[0.95fr_1.05fr] lg:gap-12 lg:py-20">
      <div>
        <p class="mb-3 inline-flex rounded-full border border-[#e8ded6] bg-white px-3.5 py-2 text-[13px] font-medium text-[#338d83] sm:mb-5 sm:px-4 sm:text-sm">
          Presencial no Centro Metropolitano e online
        </p>

        <h1 class="hero-title-mobile max-w-2xl font-normal text-[#174442] md:text-7xl md:leading-[1.05]">
          Cuidado psicológico com escuta, ética e clareza<span class="text-[#f4b3e1]">.</span>
        </h1>

        <div class="mt-4 h-2 w-24 rounded-full border-b-2 border-[#f4b3e1] sm:mt-5 sm:h-3 sm:w-32"></div>

        <p class="mt-5 max-w-xl text-[15px] leading-7 text-[#6f7774] sm:mt-8 sm:text-base sm:leading-8 md:text-lg">
          Psicoterapia e avaliação neuropsicológica para crianças, adolescentes e adultos, com atendimento presencial no Centro Metropolitano e também online.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:mt-9 sm:flex-row sm:gap-4">
          <a
            data-primary-whatsapp-cta
            data-whatsapp-cta
            data-cta-location="hero"
            data-service="general"
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-[#338d83] px-7 py-4 text-center text-sm font-semibold text-white shadow-lg shadow-[#338d83]/20 transition hover:bg-[#185c58]"
          >
            Consultar horários no WhatsApp
          </a>
          <a href="/a-elus" class="rounded-full border border-[#338d83]/50 bg-white px-7 py-4 text-center text-sm font-semibold text-[#338d83] transition hover:bg-[#f3eeea]">
            Conhecer a ELUS →
          </a>
        </div>

        <div class="mt-6 flex flex-wrap gap-2 text-xs text-[#5d6865] sm:mt-10 sm:grid sm:grid-cols-3 sm:gap-5 sm:text-sm">
          <span class="rounded-full border border-[#e8ded6] bg-white px-3 py-2 sm:border-0 sm:bg-transparent sm:px-0">♢ Ética e sigilo</span>
          <span class="rounded-full border border-[#e8ded6] bg-white px-3 py-2 sm:border-0 sm:bg-transparent sm:px-0">♡ Atendimento humanizado</span>
          <span class="rounded-full border border-[#e8ded6] bg-white px-3 py-2 sm:border-0 sm:bg-transparent sm:px-0">✦ Responsabilidade técnica</span>
        </div>
      </div>

      <div class="relative hidden lg:block">
        <figure class="soft-shadow relative ml-auto aspect-[4/5] w-full max-w-[520px] overflow-hidden rounded-[3rem] bg-[#f3eeea]">
          <img
            src="/images/elus/jessica/jessica-home-hero.webp"
            alt="Jéssica Albuquerque Vasconcelos no consultório da ELUS Psicologia"
            class="h-full w-full object-cover object-center"
            width="960"
            height="1200"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="absolute inset-x-5 bottom-5 rounded-[1.5rem] border border-white/70 bg-white/90 px-5 py-4 shadow-lg backdrop-blur-sm">
            <p class="text-sm font-semibold text-[#174442]">Jéssica Albuquerque Vasconcelos</p>
            <p class="mt-1 text-xs text-[#6f7774]">Psicóloga clínica e neuropsicóloga · {site.crp}</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="servicos" class="mobile-section border-y border-[#e8ded6] bg-white py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-xl text-center">
          <p class="text-xs font-bold uppercase tracking-[0.20em] text-[#338d83] sm:text-sm sm:tracking-[0.22em]">Como posso ajudar</p>
          <h2 class="mt-3 text-4xl font-normal text-[#174442] md:mt-4 md:text-5xl">Serviços</h2>
          <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>

        <div class="mt-9 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-2 xl:grid-cols-4">
          {services.map((service) => (
            <article class="card-border soft-shadow rounded-[1.5rem] bg-white p-6 text-left transition hover:-translate-y-1 sm:rounded-[1.75rem] sm:p-8 sm:text-center">
              <div class={`flex h-14 w-14 items-center justify-center rounded-full ${service.color} text-2xl text-white sm:mx-auto sm:h-20 sm:w-20 sm:text-3xl`}>{service.icon}</div>
              <h3 class="mt-5 text-2xl font-normal text-[#174442] sm:mt-7">{service.title}</h3>
              <p class="mt-3 text-sm leading-6 text-[#6f7774] sm:mt-4 sm:leading-7">{service.description}</p>
              <a href={service.href} class="mt-5 inline-flex text-sm font-semibold text-[#338d83] sm:mt-7">Saiba mais →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mobile-section bg-[#fbf8f5] py-20">
      <div class="container-elus grid gap-4 sm:gap-6 lg:grid-cols-2">
        <article class="card-border soft-shadow overflow-hidden rounded-[1.75rem] bg-white sm:rounded-[2rem]">
          <img src="/images/elus/espaco/acolhimento-janela.webp" alt="Ambiente acolhedor da ELUS Psicologia com luz natural" class="h-56 w-full object-cover object-center sm:h-72" width="1200" height="800" loading="lazy" decoding="async" />
          <div class="p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-[0.20em] text-[#338d83] sm:text-sm sm:tracking-[0.22em]">A ELUS</p>
            <h2 class="mt-3 text-3xl font-normal leading-tight text-[#174442] sm:mt-4">Um espaço criado para acolher.</h2>
            <p class="mt-4 text-sm leading-6 text-[#6f7774] sm:mt-5 sm:leading-7">Conheça os ambientes da clínica, o endereço no Centro Metropolitano e as informações para sua visita.</p>
            <a href="/a-elus" class="mt-5 inline-flex text-sm font-semibold text-[#338d83] sm:mt-6">Conhecer o espaço →</a>
          </div>
        </article>

        <article class="card-border soft-shadow grid overflow-hidden rounded-[1.75rem] bg-white sm:grid-cols-[0.8fr_1.2fr] sm:rounded-[2rem]">
          <img src="/images/elus/jessica/jessica-sobre.webp" alt="Jéssica Albuquerque Vasconcelos no consultório da ELUS Psicologia" class="aspect-[4/5] w-full object-cover object-[center_18%] sm:h-full sm:min-h-[420px] sm:object-[center_16%]" width="960" height="1200" loading="lazy" decoding="async" />
          <div class="flex flex-col justify-center p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-[0.20em] text-[#338d83] sm:text-sm sm:tracking-[0.22em]">Profissional responsável</p>
            <h2 class="mt-3 text-3xl font-normal leading-tight text-[#174442] sm:mt-4">{site.professionalName}</h2>
            <p class="mt-2 text-sm text-[#6f7774] sm:mt-3">{site.crp}</p>
            <p class="mt-4 text-sm leading-6 text-[#6f7774] sm:mt-5 sm:leading-7">Psicóloga clínica e neuropsicóloga, com atuação fundamentada em escuta acolhedora, ética e responsabilidade técnica.</p>
            <a href="/sobre-jessica" class="mt-5 inline-flex text-sm font-semibold text-[#338d83] sm:mt-6">Conhecer a trajetória →</a>
          </div>
        </article>
      </div>
    </section>

    <section class="mobile-section bg-white py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-xs font-bold uppercase tracking-[0.20em] text-[#338d83] sm:text-sm sm:tracking-[0.22em]">Como funciona</p>
          <h2 class="mt-3 text-4xl font-normal text-[#174442] md:mt-4 md:text-5xl">Seu primeiro passo é simples</h2>
          <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>

        <div class="mt-9 grid gap-4 sm:mt-14 sm:gap-6 md:grid-cols-3">
          {steps.map((step) => (
            <article class="relative rounded-[1.5rem] bg-[#fbf8f5] p-5 sm:rounded-[1.75rem] sm:p-7">
              <div class="flex items-start gap-4 sm:gap-5">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#338d83] text-sm font-bold text-white">{step.number}</span>
                <div>
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-2xl sm:h-16 sm:w-16 sm:text-3xl">{step.icon}</div>
                  <h3 class="mt-4 text-xl font-semibold text-[#174442] sm:mt-5">{step.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-[#6f7774] sm:mt-3 sm:leading-7">{step.text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contato" class="bg-white pb-12 sm:pb-20">
      <div class="container-elus">
        <div class="relative overflow-hidden rounded-[1.75rem] bg-[#338d83] p-7 text-white sm:rounded-[2rem] sm:p-9 md:p-12">
          <div class="absolute -left-16 -top-16 h-52 w-52 rounded-full border border-white/20"></div>
          <div class="absolute -right-16 -bottom-16 h-56 w-56 rounded-full border border-white/20"></div>
          <div class="relative flex flex-col items-start justify-between gap-6 md:flex-row md:items-center md:gap-8">
            <div>
              <h2 class="text-4xl font-normal">Vamos conversar?</h2>
              <p class="mt-3 max-w-xl text-sm leading-6 text-white/85 sm:text-base sm:leading-7">Tire suas dúvidas e consulte a disponibilidade de horários para atendimento presencial ou online.</p>
            </div>
            <a data-whatsapp-cta data-cta-location="final" data-service="general" href={whatsappLink} target="_blank" rel="noopener noreferrer" class="w-full rounded-full bg-white px-7 py-4 text-center text-sm font-bold text-[#338d83] transition hover:bg-[#f3eeea] sm:w-auto">Falar com a ELUS</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
