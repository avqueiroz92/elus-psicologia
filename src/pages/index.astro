---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappLink } from "../config/site";

const services = [
  {
    title: "Psicoterapia",
    icon: "💬",
    color: "bg-[#338d83]",
    href: "/psicoterapia",
    description: "Um processo de cuidado para compreender emoções, relações e experiências com acolhimento e clareza.",
  },
  {
    title: "Avaliação Neuropsicológica",
    icon: "📋",
    color: "bg-[#bfa5ed]",
    href: "/avaliacao-neuropsicologica",
    description: "Avaliação de funções cognitivas, emocionais e comportamentais, com instrumentos adequados e devolutiva cuidadosa.",
  },
  {
    title: "Atendimento Online",
    icon: "◉",
    color: "bg-[#f4b3e1]",
    href: "/atendimento-online",
    description: "Psicoterapia por videochamada, com sigilo, flexibilidade e avaliação da adequação para cada caso.",
  },
];

const steps = [
  { number: "1", title: "Entre em contato", text: "Fale com a ELUS pelo WhatsApp e informe o atendimento de interesse.", icon: "📅" },
  { number: "2", title: "Conversa inicial", text: "Compreendemos sua necessidade e orientamos sobre modalidade e horários.", icon: "💬" },
  { number: "3", title: "Inicie o processo", text: "O cuidado é conduzido de acordo com sua demanda e singularidade.", icon: "🌿" },
];
---

<BaseLayout
  title="Elus Psicologia | Psicoterapia no Centro Metropolitano e Online"
  description="Psicoterapia e avaliação neuropsicológica com Jéssica Albuquerque Vasconcelos no Centro Metropolitano, próximo à Barra da Tijuca e Barra Olímpica."
>
  <main id="inicio" class="pt-20">
    <section class="container-elus grid min-h-[calc(100vh-80px)] items-center gap-12 py-14 lg:grid-cols-[0.95fr_1.05fr] lg:py-20">
      <div>
        <p class="mb-5 inline-flex rounded-full border border-[#e8ded6] bg-white px-4 py-2 text-sm font-medium text-[#338d83]">Atendimento presencial no Centro Metropolitano e online</p>
        <h1 class="max-w-2xl text-5xl font-normal leading-[1.05] tracking-tight text-[#174442] md:text-7xl">Cuidado psicológico com escuta, ética e clareza<span class="text-[#f4b3e1]">.</span></h1>
        <div class="mt-5 h-3 w-32 rounded-full border-b-2 border-[#f4b3e1]"></div>
        <p class="mt-8 max-w-xl text-base leading-8 text-[#6f7774] md:text-lg">Psicoterapia e avaliação neuropsicológica para crianças, adolescentes e adultos. Nosso espaço fica no Centro Metropolitano, com localização próxima à Barra da Tijuca, Barra Olímpica e aos bairros da região.</p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#338d83] px-7 py-4 text-center text-sm font-semibold text-white shadow-lg shadow-[#338d83]/20 transition hover:bg-[#185c58]">Consultar horários no WhatsApp</a>
          <a href="/a-elus" class="rounded-full border border-[#338d83]/50 bg-white px-7 py-4 text-center text-sm font-semibold text-[#338d83] transition hover:bg-[#f3eeea]">Conhecer a ELUS →</a>
        </div>
        <div class="mt-12 grid gap-5 text-sm text-[#5d6865] sm:grid-cols-3">
          <div class="flex items-center gap-3"><span class="text-2xl text-[#338d83]">♢</span><span>Ética e sigilo profissional</span></div>
          <div class="flex items-center gap-3 border-[#e8ded6] sm:border-l sm:pl-5"><span class="text-2xl text-[#338d83]">♡</span><span>Atendimento humanizado</span></div>
          <div class="flex items-center gap-3 border-[#e8ded6] sm:border-l sm:pl-5"><span class="text-2xl text-[#338d83]">✦</span><span>Responsabilidade técnica</span></div>
        </div>
      </div>

      <div class="relative">
        <div class="soft-shadow relative flex min-h-[560px] items-center justify-center overflow-hidden rounded-[3rem] bg-[#f7f1ec] p-8">
          <div class="relative z-10 flex h-[460px] w-[460px] items-center justify-center rounded-[2.5rem] bg-white/75 p-8 backdrop-blur-sm">
            <img src="/icone-elus.png" alt="Ícone da marca Elus Psicologia" class="h-auto w-full max-w-[410px] object-contain" loading="eager" />
          </div>
        </div>
      </div>
    </section>

    <section id="servicos" class="border-y border-[#e8ded6] bg-white py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Como posso ajudar</p>
          <h2 class="mt-4 text-4xl font-normal text-[#174442] md:text-5xl">Serviços</h2>
          <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {services.map((service) => (
            <article class="card-border soft-shadow rounded-[1.75rem] bg-white p-8 text-center transition hover:-translate-y-1">
              <div class={`mx-auto flex h-20 w-20 items-center justify-center rounded-full ${service.color} text-3xl text-white`}>{service.icon}</div>
              <h3 class="mt-7 text-2xl font-normal text-[#174442]">{service.title}</h3>
              <p class="mt-4 text-sm leading-7 text-[#6f7774]">{service.description}</p>
              <a href={service.href} class="mt-7 inline-flex text-sm font-semibold text-[#338d83]">Saiba mais →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#fbf8f5] py-20">
      <div class="container-elus grid gap-6 lg:grid-cols-2">
        <article class="card-border soft-shadow overflow-hidden rounded-[2rem] bg-white">
          <img src="/consultorio-adulto-hero.jpg" alt="Consultório da ELUS Psicologia" class="h-72 w-full object-cover object-center" loading="lazy" />
          <div class="p-8">
            <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">A ELUS</p>
            <h2 class="mt-4 text-3xl font-normal leading-tight text-[#174442]">Um espaço criado para acolher.</h2>
            <p class="mt-5 text-sm leading-7 text-[#6f7774]">Conheça os ambientes da clínica, o endereço no Centro Metropolitano e as informações para sua visita.</p>
            <a href="/a-elus" class="mt-6 inline-flex text-sm font-semibold text-[#338d83]">Conhecer o espaço →</a>
          </div>
        </article>

        <article class="card-border soft-shadow grid overflow-hidden rounded-[2rem] bg-white sm:grid-cols-[0.8fr_1.2fr]">
          <img src="/jessica-albuquerque.jpg" alt="Jéssica Albuquerque Vasconcelos" class="h-full min-h-[360px] w-full object-cover object-top" loading="lazy" />
          <div class="flex flex-col justify-center p-8">
            <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Profissional responsável</p>
            <h2 class="mt-4 text-3xl font-normal leading-tight text-[#174442]">{site.professionalName}</h2>
            <p class="mt-3 text-sm text-[#6f7774]">{site.crp}</p>
            <p class="mt-5 text-sm leading-7 text-[#6f7774]">Psicóloga clínica e neuropsicóloga, com atuação fundamentada em escuta acolhedora, ética e responsabilidade técnica.</p>
            <a href="/sobre-jessica" class="mt-6 inline-flex text-sm font-semibold text-[#338d83]">Conhecer a trajetória →</a>
          </div>
        </article>
      </div>
    </section>

    <section class="bg-white py-20">
      <div class="container-elus">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#338d83]">Como funciona</p>
          <h2 class="mt-4 text-4xl font-normal text-[#174442] md:text-5xl">Seu primeiro passo é simples</h2>
          <div class="mx-auto mt-4 h-1 w-16 rounded-full bg-[#f4b3e1]"></div>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {steps.map((step) => (
            <article class="relative rounded-[1.75rem] bg-[#fbf8f5] p-7">
              <div class="flex items-start gap-5">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#338d83] text-sm font-bold text-white">{step.number}</span>
                <div>
                  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white text-3xl">{step.icon}</div>
                  <h3 class="mt-5 text-xl font-semibold text-[#174442]">{step.title}</h3>
                  <p class="mt-3 text-sm leading-7 text-[#6f7774]">{step.text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contato" class="bg-white pb-20">
      <div class="container-elus">
        <div class="relative overflow-hidden rounded-[2rem] bg-[#338d83] p-9 text-white md:p-12">
          <div class="absolute -left-16 -top-16 h-52 w-52 rounded-full border border-white/20"></div>
          <div class="absolute -right-16 -bottom-16 h-56 w-56 rounded-full border border-white/20"></div>
          <div class="relative flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
            <div>
              <h2 class="text-4xl font-normal">Vamos conversar?</h2>
              <p class="mt-3 max-w-xl text-white/85">Tire suas dúvidas e consulte a disponibilidade de horários para atendimento presencial ou online.</p>
            </div>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white px-7 py-4 text-sm font-bold text-[#338d83] transition hover:bg-[#f3eeea]">Falar com a ELUS</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
