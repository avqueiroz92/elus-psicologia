---
import { site, whatsappLink } from "../config/site";

const phoneDigits = String(site.phone).replace(/\D/g, "");
const nationalPhone = phoneDigits.startsWith("55") ? phoneDigits.slice(2) : phoneDigits;
const phoneDisplay = nationalPhone.length === 11
  ? `(${nationalPhone.slice(0, 2)}) ${nationalPhone.slice(2, 7)}-${nationalPhone.slice(7)}`
  : String(site.phone);
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.location)}`;
---

<footer class="border-t border-[#e8ded6] bg-[#fbf8f5] py-12">
  <div class="container-elus grid gap-10 md:grid-cols-4">
    <div>
      <img src="/logo-elus.png" alt="Elus Psicologia" class="h-20 w-auto" />
      <p class="mt-4 max-w-xs text-sm leading-6 text-[#6f7774]">
        Psicoterapia e avaliação neuropsicológica com acolhimento, ética e responsabilidade técnica.
      </p>
    </div>

    <div>
      <h3 class="font-semibold text-[#174442]">Atendimento</h3>
      <ul class="mt-4 space-y-2 text-sm text-[#6f7774]">
        <li>
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="transition hover:text-[#338d83]">
            WhatsApp: {phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="transition hover:text-[#338d83]">{site.email}</a>
        </li>
        <li>
          <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="transition hover:text-[#338d83]">
            {site.location}
          </a>
        </li>
        <li>Presencial e online</li>
      </ul>
    </div>

    <div>
      <h3 class="font-semibold text-[#174442]">Profissional responsável</h3>
      <p class="mt-4 text-sm text-[#6f7774]">{site.professionalName}</p>
      <p class="mt-2 text-sm text-[#6f7774]">{site.crp}</p>

      <a
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex text-sm font-semibold text-[#338d83] transition hover:text-[#185c58]"
      >
        Instagram {site.instagramUser} →
      </a>
    </div>

    <div>
      <h3 class="font-semibold text-[#174442]">Informações</h3>
      <a href="/sobre-jessica" class="mt-4 block text-sm text-[#6f7774] transition hover:text-[#338d83]">
        Sobre Jéssica
      </a>
      <a href="/avaliacao-neuropsicologica" class="mt-2 block text-sm text-[#6f7774] transition hover:text-[#338d83]">
        Avaliação Neuropsicológica
      </a>
      <a href="/politica-de-privacidade" class="mt-2 block text-sm text-[#6f7774] transition hover:text-[#338d83]">
        Política de Privacidade
      </a>
      <p class="mt-8 text-sm text-[#6f7774]">
        © {new Date().getFullYear()} Elus Psicologia.<br />
        Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>
