---
import { site, whatsappLink } from "../config/site";

const phoneDigits = String(site.phone).replace(/\D/g, "");
const nationalPhone = phoneDigits.startsWith("55") ? phoneDigits.slice(2) : phoneDigits;
const phoneDisplay = nationalPhone.length === 11
  ? `(${nationalPhone.slice(0, 2)}) ${nationalPhone.slice(2, 7)}-${nationalPhone.slice(7)}`
  : String(site.phone);
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.location)}`;
---

<footer class="border-t border-[#e8ded6] bg-[#fbf8f5] py-12">
  <div class="container-elus grid gap-10 md:grid-cols-3">
    <div>
      <img src="/logo-elus.png" alt="Elus Psicologia" class="h-20 w-auto" />
      <p class="mt-4 max-w-sm text-sm leading-6 text-[#6f7774]">
        Psicoterapia e avaliação neuropsicológica com acolhimento, ética e responsabilidade técnica.
      </p>
      <p class="mt-4 text-sm text-[#6f7774]">
        {site.professionalName} · {site.crp}
      </p>
    </div>

    <div>
      <h3 class="font-semibold text-[#174442]">Contato</h3>
      <ul class="mt-4 space-y-3 text-sm leading-6 text-[#6f7774]">
        <li><a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="transition hover:text-[#338d83]">WhatsApp: {phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`} class="transition hover:text-[#338d83]">{site.email}</a></li>
        <li><a href={mapsLink} target="_blank" rel="noopener noreferrer" class="transition hover:text-[#338d83]">{site.placeName}<br />{site.location}</a></li>
        <li>Atendimento presencial e online, mediante agendamento.</li>
      </ul>
    </div>

    <div>
      <h3 class="font-semibold text-[#174442]">Navegação</h3>
      <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm text-[#6f7774]">
        <a href="/" class="transition hover:text-[#338d83]">Início</a>
        <a href="/a-elus" class="transition hover:text-[#338d83]">A ELUS</a>
        <a href="/psicoterapia" class="transition hover:text-[#338d83]">Psicoterapia</a>
        <a href="/avaliacao-neuropsicologica" class="transition hover:text-[#338d83]">Avaliação Neuropsicológica</a>
        <a href="/atendimento-online" class="transition hover:text-[#338d83]">Atendimento Online</a>
        <a href="/sobre-jessica" class="transition hover:text-[#338d83]">Jéssica Albuquerque</a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="transition hover:text-[#338d83]">Instagram</a>
        <a href="/politica-de-privacidade" class="transition hover:text-[#338d83]">Privacidade</a>
      </div>
      <p class="mt-8 text-sm text-[#6f7774]">© {new Date().getFullYear()} Elus Psicologia. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
