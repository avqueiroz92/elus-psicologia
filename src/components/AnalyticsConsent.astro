---
import { site } from "../config/site";

const measurementId = site.analyticsMeasurementId;
---

<div
  id="analytics-consent"
  data-measurement-id={measurementId}
  class="fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-3xl flex-col rounded-3xl border border-[#e8ded6] bg-white p-5 shadow-2xl shadow-[#174442]/20 md:inset-x-8 md:flex-row md:items-center md:justify-between md:gap-6"
  role="dialog"
  aria-live="polite"
  aria-label="Preferências de métricas do site"
>
  <div class="max-w-2xl">
    <p class="text-base font-bold text-[#174442]">Métricas e privacidade</p>
    <p class="mt-2 text-sm leading-6 text-[#6f7774]">
      Usamos métricas do Google Analytics para entender, de forma agregada, como o site é utilizado e melhorar a experiência. Nenhuma informação clínica deve ser enviada por esse recurso.
      <a href="/politica-de-privacidade/" class="font-semibold text-[#338d83] underline decoration-[#338d83]/30 underline-offset-4">Saiba mais</a>.
    </p>
  </div>

  <div class="mt-4 flex flex-col gap-2 sm:flex-row md:mt-0 md:shrink-0">
    <button
      type="button"
      id="analytics-reject"
      class="rounded-full border border-[#d8cec6] bg-white px-5 py-3 text-sm font-bold text-[#174442] transition hover:border-[#338d83]"
    >
      Recusar
    </button>
    <button
      type="button"
      id="analytics-accept"
      class="rounded-full bg-[#338d83] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#185c58]"
    >
      Aceitar métricas
    </button>
  </div>
</div>

<script>
  const CONSENT_KEY = "elus-analytics-consent";
  const CAMPAIGN_KEY = "elus-campaign-attribution";
  const CAMPAIGN_PARAMS = [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_content",
    "utm_term",
    "gclid",
    "gbraid",
    "wbraid",
  ];
  const PRODUCTION_HOSTS = ["eluspsicologia.com.br", "www.eluspsicologia.com.br"];

  const consentBox = document.getElementById("analytics-consent");
  const acceptButton = document.getElementById("analytics-accept");
  const rejectButton = document.getElementById("analytics-reject");
  const measurementId = consentBox?.dataset.measurementId || "";

  const windowWithAnalytics = window;
  windowWithAnalytics.dataLayer = windowWithAnalytics.dataLayer || [];
  windowWithAnalytics.gtag =
    windowWithAnalytics.gtag ||
    function gtag() {
      windowWithAnalytics.dataLayer.push(arguments);
    };

  function hideConsentBox() {
    consentBox?.classList.add("hidden");
    consentBox?.classList.remove("flex");
  }

  function showConsentBox() {
    consentBox?.classList.remove("hidden");
    consentBox?.classList.add("flex");
  }

  function consentState(value) {
    return {
      analytics_storage: value,
      ad_storage: value,
      ad_user_data: value,
      ad_personalization: value,
    };
  }

  function readCampaignParams() {
    const params = new URLSearchParams(window.location.search);
    const current = {};

    CAMPAIGN_PARAMS.forEach((key) => {
      const value = params.get(key);
      if (value) current[key] = value.slice(0, 200);
    });

    if (Object.keys(current).length) {
      current.landing_page = window.location.pathname;
      current.captured_at = new Date().toISOString();
    }

    return current;
  }

  function captureCampaignAttribution() {
    if (localStorage.getItem(CONSENT_KEY) !== "accepted") return;

    const current = readCampaignParams();
    if (Object.keys(current).length) {
      sessionStorage.setItem(CAMPAIGN_KEY, JSON.stringify(current));
    }
  }

  function getCampaignAttribution() {
    if (localStorage.getItem(CONSENT_KEY) !== "accepted") return {};

    const current = readCampaignParams();
    if (Object.keys(current).length) return current;

    try {
      return JSON.parse(sessionStorage.getItem(CAMPAIGN_KEY) || "{}");
    } catch {
      return {};
    }
  }

  function inferService(anchor) {
    const explicit = anchor.dataset.service;
    if (explicit) return explicit;

    const path = window.location.pathname;
    if (path.includes("/psicoterapia-infantil")) return "psicoterapia_infantil";
    if (path.includes("/psicoterapia")) return "psicoterapia";
    if (path.includes("/avaliacao-neuropsicologica")) return "avaliacao_neuropsicologica";
    if (path.includes("/atendimento-online")) return "atendimento_online";
    return "general";
  }

  function inferCtaLocation(anchor) {
    if (anchor.dataset.ctaLocation) return anchor.dataset.ctaLocation;
    if (anchor.closest("header")) return "header";
    if (anchor.closest("footer")) return "footer";
    return "inline_unspecified";
  }

  function loadGoogleTag() {
    if (!PRODUCTION_HOSTS.includes(window.location.hostname)) return;
    if (!measurementId || windowWithAnalytics.__elusAnalyticsLoaded) return;

    windowWithAnalytics.__elusAnalyticsLoaded = true;

    const analyticsScript = document.createElement("script");
    analyticsScript.async = true;
    analyticsScript.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
    document.head.appendChild(analyticsScript);

    windowWithAnalytics.gtag("js", new Date());
    windowWithAnalytics.gtag("config", measurementId, {
      send_page_view: true,
    });
  }

  function updateConsent(value) {
    windowWithAnalytics.gtag("consent", "update", consentState(value));
  }

  function trackContactEvent(eventName, anchor) {
    if (typeof windowWithAnalytics.gtag !== "function") return;

    const campaign = getCampaignAttribution();

    windowWithAnalytics.gtag("event", eventName, {
      link_url: anchor.href,
      link_text: (anchor.textContent || anchor.getAttribute("aria-label") || "").trim().slice(0, 100),
      page_path: window.location.pathname,
      page_title: document.title,
      cta_location: inferCtaLocation(anchor),
      service: inferService(anchor),
      ...campaign,
    });
  }

  const savedConsent = localStorage.getItem(CONSENT_KEY);
  const initialConsent = savedConsent === "accepted" ? "granted" : "denied";

  // Consent Mode v2 avançado: o estado padrão é definido antes do Google tag.
  // Sem consentimento, o Google tag pode enviar medições sem cookies e respeita
  // analytics_storage/ad_storage/ad_user_data/ad_personalization como denied.
  const defaultConsent = consentState(initialConsent);
  if (!savedConsent) defaultConsent.wait_for_update = 500;
  windowWithAnalytics.gtag("consent", "default", defaultConsent);

  loadGoogleTag();

  if (savedConsent === "accepted") {
    captureCampaignAttribution();
    hideConsentBox();
  } else if (savedConsent === "rejected") {
    hideConsentBox();
  } else {
    showConsentBox();
  }

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const anchor = target.closest("a[href]");
    if (!(anchor instanceof HTMLAnchorElement)) return;

    const href = anchor.href.toLowerCase();

    if (href.startsWith("tel:")) {
      trackContactEvent("phone_click", anchor);
      return;
    }

    if (href.startsWith("mailto:")) {
      trackContactEvent("email_click", anchor);
      return;
    }

    if (href.includes("wa.me/") || href.includes("api.whatsapp.com/") || href.includes("web.whatsapp.com/")) {
      trackContactEvent("whatsapp_click", anchor);
      return;
    }

    if (
      href.includes("google.com/maps") ||
      href.includes("maps.google.") ||
      href.includes("maps.app.goo.gl")
    ) {
      trackContactEvent("directions_click", anchor);
    }
  });

  acceptButton?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "accepted");
    updateConsent("granted");
    captureCampaignAttribution();
    hideConsentBox();
  });

  rejectButton?.addEventListener("click", () => {
    localStorage.setItem(CONSENT_KEY, "rejected");
    sessionStorage.removeItem(CAMPAIGN_KEY);
    updateConsent("denied");
    hideConsentBox();
  });
</script>
