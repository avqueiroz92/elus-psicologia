---
import { whatsappLink } from "../config/site";

const serviceItems = [
  { label: "Psicoterapia", href: "/psicoterapia" },
  { label: "Avaliação Neuropsicológica", href: "/avaliacao-neuropsicologica" },
  { label: "Atendimento Online", href: "/atendimento-online" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-[#e8ded6]/80 bg-[#fbf8f5]/95 backdrop-blur-xl">
  <div class="container-elus flex min-h-20 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3" aria-label="Ir para o início da Elus Psicologia">
      <img
        src="/logo-elus.png"
        alt="Elus Psicologia"
        class="h-16 w-auto sm:h-20"
        loading="eager"
      />
    </a>

    <nav class="hidden items-center gap-6 text-sm text-[#4e5c59] lg:flex" aria-label="Navegação principal">
      <a href="/" class="transition hover:text-[#338d83]">Início</a>
      <a href="/a-elus" class="transition hover:text-[#338d83]">A ELUS</a>

      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-1 transition hover:text-[#338d83]">
          Serviços
          <svg class="h-4 w-4 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>

        <div class="absolute left-1/2 top-8 w-72 -translate-x-1/2 rounded-2xl border border-[#e8ded6] bg-white p-3 shadow-xl">
          {serviceItems.map((item) => (
            <a href={item.href} class="block rounded-xl px-4 py-3 transition hover:bg-[#fbf8f5] hover:text-[#338d83]">
              {item.label}
            </a>
          ))}
        </div>
      </details>

      <a href="/sobre-jessica" class="transition hover:text-[#338d83]">Jéssica Albuquerque</a>
      <a href="/#contato" class="transition hover:text-[#338d83]">Contato</a>
    </nav>

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-full bg-[#338d83] px-5 py-3 text-sm font-semibold text-white shadow-md shadow-[#338d83]/20 transition hover:bg-[#185c58] lg:inline-flex"
    >
      Consultar horários
    </a>

    <details class="group relative lg:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-[#e8ded6] bg-white text-[#174442] shadow-sm transition hover:border-[#338d83]/50"
        aria-label="Abrir menu de navegação"
      >
        <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </summary>

      <nav class="absolute right-0 top-14 max-h-[calc(100vh-96px)] w-[min(340px,calc(100vw-32px))] overflow-y-auto rounded-2xl border border-[#e8ded6] bg-white p-4 shadow-xl" aria-label="Navegação móvel">
        <div class="flex flex-col">
          <a href="/" class="rounded-xl px-4 py-3 text-sm text-[#4e5c59] transition hover:bg-[#fbf8f5] hover:text-[#338d83]">Início</a>
          <a href="/a-elus" class="rounded-xl px-4 py-3 text-sm text-[#4e5c59] transition hover:bg-[#fbf8f5] hover:text-[#338d83]">A ELUS</a>

          <details class="group/services">
            <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl px-4 py-3 text-sm text-[#4e5c59] transition hover:bg-[#fbf8f5] hover:text-[#338d83]">
              Serviços
              <svg class="h-4 w-4 transition group-open/services:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="ml-3 border-l border-[#e8ded6] pl-3">
              {serviceItems.map((item) => (
                <a href={item.href} class="block rounded-xl px-4 py-3 text-sm text-[#4e5c59] transition hover:bg-[#fbf8f5] hover:text-[#338d83]">
                  {item.label}
                </a>
              ))}
            </div>
          </details>

          <a href="/sobre-jessica" class="rounded-xl px-4 py-3 text-sm text-[#4e5c59] transition hover:bg-[#fbf8f5] hover:text-[#338d83]">Jéssica Albuquerque</a>
          <a href="/#contato" class="rounded-xl px-4 py-3 text-sm text-[#4e5c59] transition hover:bg-[#fbf8f5] hover:text-[#338d83]">Contato</a>

          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 rounded-full bg-[#338d83] px-5 py-3 text-center text-sm font-semibold text-white"
          >
            Consultar horários no WhatsApp
          </a>
        </div>
      </nav>
    </details>
  </div>
</header>
