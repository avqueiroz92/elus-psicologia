---
import { site } from "../config/site";
import { contentBySlug } from "../config/content";

type Props = {
  title: string;
  description: string;
  canonicalURL: URL;
};

const { title, description, canonicalURL } = Astro.props;
const logoURL = new URL("/images/elus/brand/logo-elus-transparent.png", site.url).href;
const businessImageURL = new URL("/images/elus/espaco/acolhimento-janela.webp", site.url).href;
const professionalImageURL = new URL("/images/elus/jessica/jessica-sobre.webp", site.url).href;
const businessId = `${site.url}/#business`;
const websiteId = `${site.url}/#website`;
const personId = `${site.url}/sobre-jessica/#person`;
const webpageId = `${canonicalURL.href}#webpage`;
const phoneDigits = String(site.phone).replace(/\D/g, "");
const internationalPhone = phoneDigits.startsWith("55") ? `+${phoneDigits}` : `+55${phoneDigits}`;
const normalizedPath = canonicalURL.pathname.replace(/\/+$/, "") || "/";

const servicesByPath: Record<string, { name: string; description: string; local: boolean }> = {
  "/psicoterapia": {
    name: "Psicoterapia",
    description: "Psicoterapia para crianças, adolescentes e adultos, presencial no Centro Metropolitano, na Barra Olímpica, e também online.",
    local: true,
  },
  "/psicoterapia-infantil": {
    name: "Psicoterapia Infantil",
    description: "Psicoterapia infantil presencial na ELUS Psicologia, com participação dos responsáveis quando indicada.",
    local: true,
  },
  "/avaliacao-neuropsicologica": {
    name: "Avaliação Neuropsicológica",
    description: "Avaliação neuropsicológica para crianças, adolescentes e adultos, com entrevista, instrumentos adequados, análise integrada e devolutiva.",
    local: true,
  },
  "/atendimento-online": {
    name: "Psicoterapia Online",
    description: "Psicoterapia online por videochamada, com ética, sigilo e avaliação da adequação da modalidade para cada caso.",
    local: false,
  },
};

const localAreas = [
  { "@type": "Place", name: "Barra Olímpica" },
  { "@type": "Place", name: "Jacarepaguá" },
  { "@type": "Place", name: "Barra da Tijuca" },
  { "@type": "City", name: "Rio de Janeiro" },
];

const currentService = servicesByPath[normalizedPath];
const serviceId = currentService ? `${canonicalURL.href}#service` : null;
const contentMatch = normalizedPath.match(/^\/conteudos\/([^/]+)$/);
const contentItem = contentMatch ? contentBySlug[contentMatch[1]] : undefined;
const isContentHub = normalizedPath === "/conteudos";
const isProfilePage = normalizedPath === "/sobre-jessica";
const articleId = contentItem ? `${canonicalURL.href}#article` : null;

const pageAboutId = currentService
  ? serviceId
  : isProfilePage
    ? personId
    : contentItem
      ? personId
      : businessId;

const webPageTypes = isProfilePage
  ? ["WebPage", "ProfilePage"]
  : isContentHub
    ? ["WebPage", "CollectionPage"]
    : "WebPage";

const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: site.url,
    name: site.name,
    inLanguage: "pt-BR",
    publisher: { "@id": businessId },
  },
  {
    "@type": "LocalBusiness",
    "@id": businessId,
    name: site.name,
    url: site.url,
    logo: logoURL,
    image: businessImageURL,
    description: site.description,
    email: site.email,
    telephone: internationalPhone,
    address: {
      "@type": "PostalAddress",
      streetAddress: "Avenida Ator José Wilker, 605",
      addressLocality: "Rio de Janeiro",
      addressRegion: "RJ",
      postalCode: "22775-024",
      addressCountry: "BR",
    },
    areaServed: [
      { "@type": "Place", name: "Centro Metropolitano" },
      ...localAreas,
    ],
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        opens: "08:00",
        closes: "18:00",
      },
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: "Saturday",
        opens: "09:00",
        closes: "13:00",
      },
    ],
    employee: { "@id": personId },
    sameAs: [site.instagram],
  },
  {
    "@type": "Person",
    "@id": personId,
    name: site.professionalName,
    url: `${site.url}/sobre-jessica/`,
    image: professionalImageURL,
    jobTitle: "Psicóloga clínica e neuropsicóloga",
    identifier: {
      "@type": "PropertyValue",
      propertyID: "CRP",
      value: "05/87372",
    },
    worksFor: { "@id": businessId },
    knowsAbout: [
      "Psicoterapia",
      "Psicoterapia Infantil",
      "Neuropsicologia",
      "Avaliação Neuropsicológica",
      "Orientação parental",
      "Neurodivergência",
    ],
  },
  {
    "@type": webPageTypes,
    "@id": webpageId,
    url: canonicalURL.href,
    name: title,
    description,
    inLanguage: "pt-BR",
    isPartOf: { "@id": websiteId },
    about: { "@id": pageAboutId },
    ...(isProfilePage ? { mainEntity: { "@id": personId } } : {}),
    ...(contentItem && articleId ? { mainEntity: { "@id": articleId } } : {}),
  },
];

if (currentService && serviceId) {
  const serviceNode: Record<string, unknown> = {
    "@type": "Service",
    "@id": serviceId,
    name: currentService.name,
    description: currentService.description,
    url: canonicalURL.href,
    provider: { "@id": businessId },
  };

  if (currentService.local) {
    serviceNode.areaServed = localAreas;
  }

  graph.push(serviceNode);
}

if (contentItem && articleId) {
  graph.push({
    "@type": "BlogPosting",
    "@id": articleId,
    headline: contentItem.title,
    description: contentItem.description,
    url: canonicalURL.href,
    inLanguage: "pt-BR",
    mainEntityOfPage: { "@id": webpageId },
    author: { "@id": businessId },
    reviewedBy: { "@id": personId },
    dateModified: contentItem.reviewedAt,
    publisher: { "@id": businessId },
    image: businessImageURL,
    about: contentItem.category,
  });

  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL.href}#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: `${site.url}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Conteúdos",
        item: `${site.url}/conteudos/`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: contentItem.title,
        item: canonicalURL.href,
      },
    ],
  });
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
